{
  "name": "@fmmenchi/ci",
  "version": "0.0.17",
  "description": "CI helper scripts for an Nx release monorepo — prints the releasable projects Nx marks affected between two refs.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmmenchi/shared-platform.git",
    "directory": "packages/ops/ci"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@fmmenchi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./release": "./dist/release.js",
    "./notify": "./dist/notify.js"
  },
  "nx": {
    "tags": [
      "scope:ops",
      "type:util",
      "doc:ops"
    ]
  },
  "dependencies": {
    "@fmmenchi/notify": "workspace:*",
    "tslib": "^2.3.0"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "nx": "^23.1.1",
    "@nx/devkit": "^23.1.1"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    },
    "@nx/devkit": {
      "optional": true
    }
  },
  "bin": {
    "fmmenchi-release": "./dist/release.js",
    "fmmenchi-notify": "./dist/notify.js"
  }
}
