{
  "name": "@fmmenchi/gh-actions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:ops",
      "type:util",
      "doc:ops"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "echo \"skip npm publish — private ops toolkit (versioned + tagged only)\""
        }
      }
    }
  },
  "dependencies": {}
}
