{
  "name": "@fmmenchi/tokens",
  "version": "0.0.32",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmmenchi/shared-platform.git",
    "directory": "packages/client/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@fmmenchi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "@fmmenchi/source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./validate": {
      "@fmmenchi/source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./resolve": {
      "@fmmenchi/source": "./src/utils/css.ts",
      "types": "./dist/utils/css.d.ts",
      "import": "./dist/utils/css.js",
      "default": "./dist/utils/css.js"
    },
    "./styles/tailwind.css": "./src/styles/tailwind.css",
    "./styles/vars.css": "./src/styles/vars.css",
    "./styles/baseline.css": "./src/styles/baseline.css",
    "./styles/properties.css": "./src/styles/properties.css",
    "./styles/presets/dark.css": "./src/styles/presets/dark.css",
    "./styles/motion.css": "./src/styles/motion.css"
  },
  "nx": {
    "tags": [
      "scope:client",
      "type:util",
      "doc:client"
    ]
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "tslib": "^2.3.0"
  }
}
