{
  "name": "@fmmenchi/ui",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmmenchi/shared-platform.git",
    "directory": "packages/client/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@fmmenchi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "@fmmenchi/source": "./src/components/button/index.ts",
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./style.css": "./dist/style.css",
    "./button/style.css": "./dist/button.css",
    "./badge": {
      "@fmmenchi/source": "./src/components/badge/index.ts",
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/badge.js",
      "default": "./dist/badge.js"
    },
    "./badge/style.css": "./dist/badge.css",
    "./input": {
      "@fmmenchi/source": "./src/components/input/index.ts",
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/input.js",
      "default": "./dist/input.js"
    },
    "./input/style.css": "./dist/input.css",
    "./field": {
      "@fmmenchi/source": "./src/components/field/index.ts",
      "types": "./dist/components/field/index.d.ts",
      "import": "./dist/field.js",
      "default": "./dist/field.js"
    },
    "./field/style.css": "./dist/field.css",
    "./fieldset": {
      "@fmmenchi/source": "./src/components/fieldset/index.ts",
      "types": "./dist/components/fieldset/index.d.ts",
      "import": "./dist/fieldset.js",
      "default": "./dist/fieldset.js"
    },
    "./fieldset/style.css": "./dist/fieldset.css",
    "./field-label": {
      "@fmmenchi/source": "./src/components/field-label/index.ts",
      "types": "./dist/components/field-label/index.d.ts",
      "import": "./dist/field-label.js",
      "default": "./dist/field-label.js"
    },
    "./field-label/style.css": "./dist/field-label.css",
    "./field-description": {
      "@fmmenchi/source": "./src/components/field-description/index.ts",
      "types": "./dist/components/field-description/index.d.ts",
      "import": "./dist/field-description.js",
      "default": "./dist/field-description.js"
    },
    "./field-description/style.css": "./dist/field-description.css",
    "./field-error": {
      "@fmmenchi/source": "./src/components/field-error/index.ts",
      "types": "./dist/components/field-error/index.d.ts",
      "import": "./dist/field-error.js",
      "default": "./dist/field-error.js"
    },
    "./field-error/style.css": "./dist/field-error.css",
    "./fieldset-legend": {
      "@fmmenchi/source": "./src/components/fieldset-legend/index.ts",
      "types": "./dist/components/fieldset-legend/index.d.ts",
      "import": "./dist/fieldset-legend.js",
      "default": "./dist/fieldset-legend.js"
    },
    "./fieldset-legend/style.css": "./dist/fieldset-legend.css",
    "./fieldset-content": {
      "@fmmenchi/source": "./src/components/fieldset-content/index.ts",
      "types": "./dist/components/fieldset-content/index.d.ts",
      "import": "./dist/fieldset-content.js",
      "default": "./dist/fieldset-content.js"
    },
    "./fieldset-content/style.css": "./dist/fieldset-content.css",
    "./input-group": {
      "@fmmenchi/source": "./src/components/input-group/index.ts",
      "types": "./dist/components/input-group/index.d.ts",
      "import": "./dist/input-group.js",
      "default": "./dist/input-group.js"
    },
    "./input-group/style.css": "./dist/input-group.css",
    "./radio": {
      "@fmmenchi/source": "./src/components/radio/index.ts",
      "types": "./dist/components/radio/index.d.ts",
      "import": "./dist/radio.js",
      "default": "./dist/radio.js"
    },
    "./radio/style.css": "./dist/radio.css"
  },
  "nx": {
    "tags": [
      "scope:client",
      "type:ui",
      "doc:client"
    ],
    "targets": {
      "lint-css": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/.stylelintrc.json"
        ],
        "options": {
          "command": "stylelint \"{projectRoot}/src/**/*.module.css\""
        }
      },
      "codegen": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node .storybook/generate-manager-theme.mjs",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fmmenchi/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tslib": "^2.3.0"
  }
}
