{
  "name": "@fmmenchi/nx-theme-generator",
  "version": "0.0.22",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmmenchi/shared-platform.git",
    "directory": "packages/plugins/theme-generator"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@fmmenchi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "packages/plugins/theme-generator",
          "command": "vite build"
        }
      }
    },
    "tags": [
      "scope:plugins",
      "type:plugin",
      "doc:plugins"
    ]
  },
  "dependencies": {
    "@nx/devkit": "23.1.2",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "tslib": "^2.3.0"
  },
  "generators": "./generators.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "executors.json"
  ],
  "executors": "./executors.json",
  "devDependencies": {
    "@fmmenchi/theme": "workspace:*"
  }
}
